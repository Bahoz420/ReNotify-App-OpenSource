<?xml version="1.0" encoding="utf-8"?>
<!-- The quiet widget: how many notifications came in today and which apps sent
     them. No titles, no text, nothing to read. Tapping opens the history. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/summary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/summary_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/widget_label"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/summary_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/summary_icon_1"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/summary_icon_2"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/summary_icon_3"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/summary_icon_4"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null" />
</LinearLayout>
