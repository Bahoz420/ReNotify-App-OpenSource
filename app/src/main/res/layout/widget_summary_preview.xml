<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview only, see widget_summary.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="12"
        android:textColor="@color/widget_label"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:text="@string/widget_summary_today"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_cat_chat"
        android:tint="@color/widget_blue"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_cat_cart"
        android:tint="@color/widget_secondary"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_cat_calendar"
        android:tint="@color/widget_secondary"
        android:contentDescription="@null" />
</LinearLayout>
